{
    "name": "bensomething/craft-namecheck",
    "description": "Automatically link the names of your entries wherever your content mentions them.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "plugin",
        "links",
        "autolink",
        "mentions",
        "internal links"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-namecheck/issues",
        "source": "https://github.com/bensomething/craft-namecheck"
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "craftcms/cms": "^5.10"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\namecheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "bensomething\\namecheck\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "namecheck",
        "name": "Namecheck",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-namecheck",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-namecheck/develop/CHANGELOG.md",
        "class": "bensomething\\namecheck\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    }
}
