{% import '_includes/forms.twig' as forms %}

{{ forms.checkboxSelectField({
    label: 'Link To'|t('namecheck'),
    instructions: 'Entries in these sections are linked wherever they’re mentioned. Add a Namecheck field to their entry types to give an entry other names, or to link it only where it’s related.'|t('namecheck'),
    id: 'targetSections',
    name: 'targetSections',
    options: sections,
    values: settings.targetSections,
}) }}

{{ forms.checkboxSelectField({
    label: 'Track Mentions In'|t('namecheck'),
    instructions: 'Entries in these sections are checked for mentions when they’re saved, so `craft.namecheck.mentionedIn()` can list them. Changing this updates every entry in the queue.'|t('namecheck'),
    id: 'sourceSections',
    name: 'sourceSections',
    options: sections,
    values: settings.sourceSections,
}) }}

{{ forms.lightswitchField({
    label: 'Link First Mention Only'|t('namecheck'),
    instructions: 'Link each entry only the first time it’s mentioned in a piece of content.'|t('namecheck'),
    id: 'firstOnly',
    name: 'firstOnly',
    on: settings.firstOnly,
}) }}

{{ forms.lightswitchField({
    label: 'Match Case'|t('namecheck'),
    instructions: 'Match names only as they’re capitalised, so “Pulp” isn’t found in “pulp”. Recommended.'|t('namecheck'),
    id: 'caseSensitive',
    name: 'caseSensitive',
    on: settings.caseSensitive,
}) }}
